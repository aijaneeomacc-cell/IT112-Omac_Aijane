#include <stdio.h>

int main() {
    FILE *fp;
    char note[200];
    char ch;
    int num, i;

    // Create a file and write initial notes
    fp = fopen("notes.txt", "w");

    if (fp == NULL) {
        printf("Error creating file!\n");
        return 1;
    }

    printf("Writing Notes File:\n");
    printf("How many notes do you want to record? ");
    scanf("%d", &num);

    getchar(); // Clear newline

    for (i = 1; i <= num; i++) {
        printf("Note %d: ", i);
        fgets(note, sizeof(note), stdin);
        fputs(note, fp);
    }

    fclose(fp);

    printf("\nInitial notes saved successfully.\n");

    // Append an additional note
    fp = fopen("notes.txt", "a");

    if (fp == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    printf("\nEnter one additional note:\n");
    fgets(note, sizeof(note), stdin);
    fputs(note, fp);

    fclose(fp);

    printf("\nNew note added successfully.\n");

    // Read and display all saved notes
    fp = fopen("notes.txt", "r");

    if (fp == NULL) {
        printf("Error reading file!\n");
        return 1;
    }

    printf("\nReading Saved Notes:\n");

    i = 1;
    while (fgets(note, sizeof(note), fp) != NULL) {
        printf("%d. %s", i, note);
        i++;
    }

    fclose(fp);

    return 0;
}
