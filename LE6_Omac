#include <stdio.h>
 
/* ---- Function prototypes ---- */
int addition(int a, int b);
int subtraction(int a, int b);
int multiplication(int a, int b);
float division(int a, int b);
 
int main(void) {
    int num1, num2, choice;
    int result;
    float divResult;
 
    do {
        printf("Multiple functions to perform Arithmetic Operations\n\n");
 
        printf("Enter first number: ");
        scanf("%d", &num1);
        printf("Enter second number: ");
        scanf("%d", &num2);
 
        printf("\nChoose Operation:\n");
        printf("[1] Addition\n");
        printf("[2] Subtraction\n");
        printf("[3] Multiplication\n");
        printf("[4] Division\n");
        printf("[5] Exit Program\n\n");
        printf("Enter choice [1-5]: ");
        scanf("%d", &choice);
        printf("\n");
 
        switch (choice) {
            case 1:
                result = addition(num1, num2);
                printf("%d + %d = %d\n\n", num1, num2, result);
                break;
 
            case 2:
                result = subtraction(num1, num2);
                printf("%d - %d = %d\n\n", num1, num2, result);
                break;
 
            case 3:
                result = multiplication(num1, num2);
                printf("%d * %d = %d\n\n", num1, num2, result);
                break;
 
            case 4:
                if (num2 == 0) {
                    printf("Error: Division by zero is not allowed.\n\n");
                } else {
                    divResult = division(num1, num2);
                    printf("%d / %d = %.2f\n\n", num1, num2, divResult);
                }
                break;
 
            case 5:
                printf("Exiting program...\n");
                break;
 
            default:
                printf("Invalid choice. Please enter a number from 1 to 5.\n\n");
        }
 
    } while (choice != 5);
 
    return 0;
}
 
/* ---- Function definitions ---- */
int addition(int a, int b) {
    return a + b;
}
 
int subtraction(int a, int b) {
    return a - b;
}
 
int multiplication(int a, int b) {
    return a * b;
}
 
float division(int a, int b) {
    return (float)a / (float)b;
}




