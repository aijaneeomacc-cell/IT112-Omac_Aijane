#include <stdio.h>
#include <stdlib.h>

int main() {
    FILE *fp;
    int numStudents, age, i;
    char name[100], course[100];
    char line[200];

    // Writing Student Database
    printf("Writing Student Database:\n");

    printf("How many students do you want to record? ");
    scanf("%d", &numStudents);

    // Open file in write mode
    fp = fopen("student_records.txt", "w");

    if (fp == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    // Input student information
    for (i = 1; i <= numStudents; i++) {
        printf("\nStudent %d\n", i);

        printf("Enter Name: ");
        scanf(" %[^\n]", name);

        printf("Enter Age: ");
        scanf("%d", &age);

        printf("Enter Course: ");
        scanf(" %[^\n]", course);

        // Save student information
        fprintf(fp, "Student %d\n", i);
        fprintf(fp, "Name: %s\n", name);
        fprintf(fp, "Age: %d\n", age);
        fprintf(fp, "Course: %s\n", course);
        fprintf(fp, "-------------------------\n");
    }

    // Close file after writing
    fclose(fp);

    printf("\nStudent database successfully saved to file.\n");

    // Reading Student Database
    printf("\nReading Student Database:\n\n");

    // Open file in read mode
    fp = fopen("student_records.txt", "r");

    if (fp == NULL) {
        printf("Error reading file!\n");
        return 1;
    }

    // Read and display file line by line
    while (fgets(line, sizeof(line), fp) != NULL) {
        printf("%s", line);
    }

    // Close file after reading
    fclose(fp);

    return 0;
}
