#include <stdio.h>

int main() {
    int number;
    int total = 0;

    printf("Enter positive numbers to ADD (zero or negative number to STOP)\n\n");

    do {
        printf("Enter a number: ");
        scanf("%d", &number);

        if (number > 0) {
            total += number;
        }

    } while (number > 0);

    printf("Total sum is: %d\n", total);

    return 0;
}

