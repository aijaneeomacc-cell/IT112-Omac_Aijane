#include <stdio.h>

int main() {
    int choice;
    float balance = 500.00;
    float amount;

    do {
        printf("\n========== BSIT BANK ==========\n");
        printf("Please Select your Transaction\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {

            case 1:
                printf("\nYour current balance: P%.2f\n", balance);
                break;

            case 2:
                printf("\nEnter amount to deposit: ");
                scanf("%f", &amount);

                if (amount > 0) {
                    balance = balance + amount;
                    printf("P%.2f deposited successfully!\n", amount);
                } else {
                    printf("Invalid deposit amount!\n");
                }
                break;

            case 3:
                printf("\nEnter amount to withdraw: ");
                scanf("%f", &amount);

                if (amount <= 0) {
                    printf("Invalid withdrawal amount!\n");
                } else if (balance - amount >= 100.00) {
                    balance = balance - amount;
                    printf("You withdrew P%.2f successfully!\n", amount);
                } else {
                    printf("Withdrawal denied! You must maintain at least P100.00 in your account.\n");
                }
                break;

            case 4:
                printf("\nThank you for using BSIT BANK!\n");
                break;

            default:
                printf("\nInvalid choice! Please select 1-4.\n");
        }

    } while (choice != 4);

    return 0;
}
